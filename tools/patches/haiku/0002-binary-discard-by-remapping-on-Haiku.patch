index 4671564..835dc33 100644
--- a/include/engine/framework/io/binary.h
+++ b/include/engine/framework/io/binary.h
@@ -33,6 +33,8 @@ private:
     std::vector<std::byte> owned_;
     const std::byte * mapped_ = nullptr;
     size_t size_ = 0;
+    // Kept open where discard_range remaps from the file (Haiku).
+    int fd_ = -1;
 };
 
 // require_mapping forbids an owned full-file copy when mapping is unavailable.
