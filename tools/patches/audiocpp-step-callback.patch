diff --git a/include/engine/framework/runtime/step_hook.h b/include/engine/framework/runtime/step_hook.h
new file mode 100644
index 0000000..6d5daa0
--- /dev/null
+++ b/include/engine/framework/runtime/step_hook.h
@@ -0,0 +1,46 @@
+// Added by Subtitld (not part of upstream audio.cpp).
+// Copyright 2026 Subtitld contributors
+// SPDX-License-Identifier: Apache-2.0
+//
+// A per-thread hook that generation loops call once per generated step, so an
+// embedder can report progress and stop a run between two steps. The C API
+// installs it around audiocpp_session_run (audiocpp_session_set_step_callback).
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <stdexcept>
+
+namespace engine::runtime {
+
+// Thrown out of a run when the step hook asks it to stop.
+class RunCancelled : public std::runtime_error {
+public:
+    RunCancelled() : std::runtime_error("cancelled") {}
+};
+
+// Returns true to stop the run.
+using StepHook = std::function<bool(int64_t step)>;
+
+inline thread_local const StepHook * t_step_hook = nullptr;
+
+// Called by a generation loop before each step; throws RunCancelled on a stop.
+inline void report_step(int64_t step) {
+    if (t_step_hook != nullptr && *t_step_hook && (*t_step_hook)(step)) {
+        throw RunCancelled();
+    }
+}
+
+// Installs `hook` on this thread for its lifetime.
+class ScopedStepHook {
+public:
+    explicit ScopedStepHook(const StepHook * hook) : previous_(t_step_hook) { t_step_hook = hook; }
+    ~ScopedStepHook() { t_step_hook = previous_; }
+    ScopedStepHook(const ScopedStepHook &) = delete;
+    ScopedStepHook & operator=(const ScopedStepHook &) = delete;
+
+private:
+    const StepHook * previous_;
+};
+
+} // namespace engine::runtime
